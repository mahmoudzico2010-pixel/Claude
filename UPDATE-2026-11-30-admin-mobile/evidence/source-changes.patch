+++ b/public/css/wr-admin-mobile.css
@@ -0,0 +1,214 @@
+/* Wadi El Rayan — control panel, PHONE ONLY (<= 599 px).
+   Linked with media="(max-width: 599px)": above 599 px the browser applies none of it. Every selector is either a new .wam-* class
+   or a Filament class inside this media query. Delete this file to switch the phone chrome off completely. */
+
+:root {
+    --wam-nav-h: 3.75rem;
+    --wam-lang-h: 3.25rem;
+    --wam-olive: #173f35;
+    --wam-forest: #0e2e27;
+    --wam-gold: #c6a15b;
+    --wam-ivory: #f7f5ef;
+    --wam-line: #dcdedb;
+    --wam-safe-b: env(safe-area-inset-bottom, 0px);
+    --wam-end: right;
+}
+html[dir='rtl'] { --wam-end: left; }
+
+/* Anything scrolled into view (a focused field, a validation error, a tapped tab) stops clear of the topbar and of the pinned bars. */
+html { scroll-padding-top: 4rem; scroll-padding-bottom: calc(var(--wam-nav-h) + var(--wam-safe-b) + 5rem); }
+
+/* The chrome is hidden by an inline rule in the head; the phone shows it. (Specificity beats that rule.) */
+html .wam { display: block; }
+
+/* ---------- 1. Language strip (above the panel topbar, outside the drawer) ---------- */
+.wam-langs { position: relative; z-index: 50; background: #fff; border-bottom: 1px solid var(--wam-line); }
+.wam-langs form { margin: 0; }
+.wam-langs-list {
+    display: flex; gap: .125rem; margin: 0; padding: 0 .25rem; list-style: none;
+    overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch;
+    scroll-snap-type: x proximity;
+    -webkit-mask-image: linear-gradient(to var(--wam-end), #000 calc(100% - 28px), transparent);
+    mask-image: linear-gradient(to var(--wam-end), #000 calc(100% - 28px), transparent);
+}
+.wam-langs-list.wam-at-end { -webkit-mask-image: none; mask-image: none; }
+.wam-langs-list::-webkit-scrollbar { display: none; }
+.wam-langs-list li { flex: none; scroll-snap-align: center; }
+.wam-lang {
+    appearance: none; background: transparent; border: 0; border-bottom: 3px solid transparent; cursor: pointer;
+    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .125rem;
+    min-width: 4.5rem; min-height: var(--wam-lang-h); padding: .3rem .5rem;
+    font: inherit; font-size: .6875rem; line-height: 1.15; color: #484f4a;
+}
+.wam-flag { display: block; width: 21px; height: 16px; }
+.wam-flag img { display: block; width: 21px; height: 16px; object-fit: cover; border-radius: 2px; box-shadow: 0 0 0 1px rgb(0 0 0 / .14); }
+.wam-lang[aria-current] { color: var(--wam-olive); font-weight: 700; background: #f2f7f5; border-bottom-color: var(--wam-gold); }
+.wam-lang:focus-visible { outline: 3px solid var(--wam-gold); outline-offset: -3px; }
+
+/* ---------- 2. Compact header (the panel's own topbar, restyled) ---------- */
+.fi-topbar { min-height: 3.5rem; padding-inline: .5rem; gap: .25rem; }
+.wam-title {
+    margin-inline-start: .25rem; display: flex; flex-direction: column; min-width: 0; flex: 1 1 auto; text-decoration: none; color: inherit; line-height: 1.15;
+}
+.wam-title small { font-size: .625rem; letter-spacing: .08em; text-transform: uppercase; color: #8a7a4d; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.wam-title strong { font-size: 1rem; font-weight: 700; color: var(--wam-olive); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.fi-topbar .fi-icon-btn, .wam-search-btn { min-width: 2.75rem; min-height: 2.75rem; }
+.wam-search-btn { appearance: none; background: transparent; border: 0; border-radius: 3px; display: inline-flex; align-items: center; justify-content: center; color: #484f4a; cursor: pointer; }
+.wam-search-btn:focus-visible { outline: 3px solid var(--wam-gold); }
+/* Global search: an icon that opens the field full-width under the topbar. */
+.fi-global-search-ctn { display: none; }
+html.wam-search-open .fi-global-search-ctn {
+    display: block; position: fixed; inset-inline: 0; top: 3.5rem; z-index: 40; padding: .5rem .75rem; background: #fff; border-bottom: 1px solid var(--wam-line); box-shadow: 0 8px 20px rgb(0 0 0 / .12);
+}
+html.wam-search-open .fi-global-search-ctn .fi-global-search, html.wam-search-open .fi-global-search-ctn .fi-global-search-field { width: 100%; }
+
+/* ---------- 3. Bottom navigation ---------- */
+html .wam.wam-nav {
+    display: flex; position: fixed; inset-inline: 0; bottom: 0; z-index: 45; align-items: stretch;
+    height: calc(var(--wam-nav-h) + var(--wam-safe-b)); padding-bottom: var(--wam-safe-b);
+    background: var(--wam-ivory); border-top: 1px solid var(--wam-line); box-shadow: 0 -4px 14px rgb(0 0 0 / .06);
+}
+.wam-nav-item {
+    appearance: none; background: transparent; border: 0; font: inherit; cursor: pointer; text-decoration: none;
+    flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .2rem;
+    color: #5a635c; font-size: .6875rem; line-height: 1.1; padding: .25rem .125rem; border-radius: 0; -webkit-tap-highlight-color: transparent;
+}
+.wam-nav-item span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.wam-nav-item[aria-current='page'], .wam-nav-item[aria-expanded='true'] { color: var(--wam-olive); font-weight: 700; }
+.wam-nav-item[aria-current='page'] svg { background: #f0e6cc; border-radius: 999px; padding: .2rem .8rem; box-sizing: content-box; width: 22px; }
+.wam-nav-item:focus-visible { outline: 3px solid var(--wam-gold); outline-offset: -4px; }
+/* Keyboard open (class set by JS) or a focused field: the bar steps aside so it never sits on top of the input. */
+html.wam-kb .wam.wam-nav { display: none; }
+/* Room for the bar below the page, and above it for toasts. */
+.fi-main-ctn { padding-bottom: calc(var(--wam-nav-h) + var(--wam-safe-b) + 1rem); }
+html.wam-kb .fi-main-ctn { padding-bottom: 1rem; }
+.fi-no { bottom: calc(var(--wam-nav-h) + var(--wam-safe-b) + .5rem) !important; }
+html.wam-kb .fi-no { bottom: .5rem !important; }
+
+/* ---------- 4. The drawer behind "More" is the panel's own organised sidebar ---------- */
+.fi-sidebar-nav a, .fi-sidebar-item-btn, .fi-sidebar-group-btn { min-height: 2.75rem; }
+.fi-sidebar { max-width: 88vw; padding-bottom: calc(var(--wam-nav-h) + var(--wam-safe-b)); }
+
+/* ---------- 5. Pages: headings, actions, forms ---------- */
+.fi-main-ctn { overflow-x: clip; }
+.fi-page-header-main-ctn { padding-block: .75rem; row-gap: .75rem; }
+.fi-header { flex-direction: column; align-items: stretch; gap: .5rem; }
+.fi-header-heading { font-size: 1.375rem; line-height: 1.2; overflow-wrap: anywhere; }
+.fi-header-actions-ctn { flex-wrap: wrap; gap: .5rem; }
+.fi-header-actions-ctn .fi-btn, .fi-header-actions-ctn .fi-ac-btn-action { flex: 1 1 auto; justify-content: center; }
+.fi-btn, .fi-ac-btn-action { min-height: 2.75rem; }
+.fi-icon-btn { min-width: 2.75rem; min-height: 2.75rem; }
+.fi-input, .fi-select-input, select, textarea, input[type='text'], input[type='email'], input[type='tel'], input[type='number'], input[type='search'], input[type='password'], input[type='url'] { font-size: 1rem; min-height: 2.75rem; }
+.fi-input-wrp { min-height: 2.75rem; }
+.fi-fo-field-label-content, .fi-fo-field-wrp-label { font-size: .875rem; }
+.fi-section-content-ctn, .fi-section-content { padding: .875rem; }
+.fi-section-header { padding: .75rem .875rem; }
+/* One readable column for every form grid. */
+.fi-fo-field-wrp, .fi-sc-section, .fi-section { max-width: 100%; }
+.fi-sc-form .fi-grid, .fi-sc .fi-grid { grid-template-columns: minmax(0, 1fr) !important; }
+.fi-grid-col { grid-column: 1 / -1 !important; }
+/* Repeater items: full width, comfortable header buttons. */
+.fi-fo-repeater-item-header { gap: .25rem; padding: .5rem .625rem; flex-wrap: wrap; }
+.fi-fo-repeater-item-header .fi-icon-btn { min-width: 2.75rem; min-height: 2.75rem; }
+
+/* Tabs (content-language tabs, resource tabs, tab sets): one scrollable row with an end fade. */
+.fi-tabs, .fi-sc-tabs > .fi-tabs {
+    display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; max-width: 100%;
+    -webkit-mask-image: linear-gradient(to var(--wam-end), #000 calc(100% - 28px), transparent);
+    mask-image: linear-gradient(to var(--wam-end), #000 calc(100% - 28px), transparent);
+}
+.fi-tabs.wam-at-end { -webkit-mask-image: none; mask-image: none; }
+.fi-tabs::-webkit-scrollbar { display: none; }
+.fi-tabs-item { flex: none; min-height: 2.75rem; scroll-margin-inline: 1rem; }
+
+/* Save / Publish / Cancel: pinned above the bottom bar while the end of the form is still below the screen (JS adds the class and
+   keeps the row's height reserved); once the end of the form is on screen the row sits in its normal place, so it never covers content. */
+.fi-sc-actions.wam-actions-fixed {
+    position: fixed; inset-inline: 0; top: auto; height: auto; bottom: calc(var(--wam-nav-h) + var(--wam-safe-b)); z-index: 30;
+    padding: .625rem 1rem; background: var(--wam-ivory); border-top: 1px solid var(--wam-line); box-shadow: 0 -6px 16px rgb(0 0 0 / .08);
+}
+html.wam-kb .fi-sc-actions.wam-actions-fixed { bottom: 0; }
+.fi-sc-actions .fi-btn { flex: 1 1 auto; justify-content: center; }
+
+/* ---------- 6. Lists: tables, search, filters ---------- */
+.fi-ta-ctn { max-width: 100%; }
+.fi-ta-content-ctn { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
+.fi-ta-header-toolbar { flex-wrap: wrap; gap: .5rem; padding: .625rem; }
+.fi-ta-record-checkbox, .fi-ta-page-checkbox, .fi-ta-selection-cell input[type='checkbox'] { width: 1.375rem; height: 1.375rem; }
+.fi-ta-selection-cell { min-width: 3rem; }
+.fi-ta-selection-indicator { flex-wrap: wrap; gap: .5rem; padding: .625rem; }
+/* Resource lists as cards: every column stays available, labelled, in one readable stack. (JS sets data-wam-cards and the labels.) */
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards],
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody,
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > thead { display: block; width: 100%; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > thead > tr { display: flex; align-items: center; gap: .5rem; padding: .375rem .75rem; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > thead th { display: none; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > thead th.fi-ta-selection-cell { display: block; padding: 0; width: auto; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row {
+    display: grid; grid-template-columns: auto auto minmax(0, 1fr); grid-template-rows: repeat(11, auto) 1fr; align-items: start; column-gap: 0; row-gap: .125rem;
+    padding: .75rem .75rem .75rem .5rem; border-bottom: 1px solid var(--wam-line);
+}
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row > td { display: block; padding: 0; width: auto; min-width: 0; border: 0; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row > td > * { padding-block: .125rem !important; padding-inline: 0 !important; min-height: 0; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row > td[data-wam-role='select'] > * { padding: 0 !important; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row { row-gap: 0; padding-block: .625rem; }
+.fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row > td[data-wam-role='field'] [class*='fi-ta-'], .fi-resource-list-records-page .fi-ta-table[data-wam-cards] > tbody > tr.fi-ta-row > td[data-wam-role='primary'] [class*='fi-ta-'] { padding-block: .125rem !important; padding-inline: 0 !important; }
+.fi-resource-list-records-page [data-wam-role='select'] { grid-column: 1; grid-row: 1 / span 12; padding-inline-end: .5rem !important; align-self: start; }
+.fi-resource-list-records-page [data-wam-role='image'] { grid-column: 2; grid-row: 1 / span 12; padding-inline-end: .75rem !important; align-self: start; }
+.fi-resource-list-records-page [data-wam-role='primary'] { grid-column: 3; font-size: 1rem; font-weight: 600; }
+.fi-resource-list-records-page [data-wam-role='field'] { grid-column: 3; display: flex !important; gap: .5rem; align-items: baseline; font-size: .875rem; }
+.fi-resource-list-records-page [data-wam-role='field']::before { content: attr(data-wam-label); flex: none; min-width: 5.5rem; max-width: 40%; font-size: .75rem; color: #737a75; text-transform: none; }
+.fi-resource-list-records-page [data-wam-role='field']:empty, .fi-resource-list-records-page [data-wam-role='field']:not(:has(*)):not(:where(:not(:empty))) { display: none !important; }
+.fi-resource-list-records-page [data-wam-role='actions'] { grid-column: 3; padding-top: .375rem !important; }
+.fi-resource-list-records-page [data-wam-role='actions'] .fi-ta-actions { flex-wrap: wrap; gap: .375rem; }
+.fi-resource-list-records-page [data-wam-role='actions'] .fi-btn, .fi-resource-list-records-page [data-wam-role='actions'] .fi-link { min-height: 2.75rem; display: inline-flex; align-items: center; }
+
+/* Filters and the column manager open as bottom sheets. The huge shadow is the scrim (a tap on it closes the panel). */
+.fi-ta-filters-dropdown .fi-dropdown-panel,
+.fi-ta-col-manager-dropdown .fi-dropdown-panel {
+    --container-xs: 100vw; --container-sm: 100vw; --container-md: 100vw; /* Filament's width classes read these (their own max-width rule is !important in a layer) */
+    position: fixed !important; inset: auto 0 0 0 !important; transform: none !important; width: 100% !important;
+    max-height: min(85dvh, 100dvh - 4rem); overflow-y: auto; overscroll-behavior: contain; z-index: 60;
+    border-radius: 14px 14px 0 0; padding-bottom: calc(1rem + var(--wam-safe-b));
+    box-shadow: 0 0 0 100vmax rgb(14 46 39 / .45);
+}
+.fi-ta-filters-dropdown .fi-dropdown-panel::before {
+    content: ''; display: block; width: 2.5rem; height: .3125rem; margin: .5rem auto; border-radius: 99px; background: var(--wam-line);
+}
+.fi-ta-filters-actions-ctn { position: sticky; bottom: 0; background: #fff; padding-block: .5rem; }
+.fi-ta-filters-actions-ctn .fi-btn { width: 100%; justify-content: center; }
+.fi-pagination { flex-wrap: wrap; justify-content: center; gap: .5rem; }
+
+/* ---------- 7. Modals, notifications ---------- */
+.fi-modal-window { max-height: 92dvh; overflow-y: auto; }
+.fi-modal-window-ctn { align-items: flex-end; }
+.fi-modal-window:not(.fi-modal-slide-over-window) { border-radius: 14px 14px 0 0; width: 100%; max-width: none; }
+
+/* ---------- 8. Media and touch ---------- */
+.fi-fo-file-upload, .fi-fo-file-upload .filepond--root { max-width: 100%; }
+.fi-fo-file-upload .filepond--drop-label { min-height: 4.5rem; }
+img, video { max-width: 100%; height: auto; }
+.fi-fo-repeater-item-header-start-actions, .fi-fo-repeater-item-header-end-actions { gap: .25rem; }
+
+/* ---------- 9. Analytics (cards, charts, filters) ---------- */
+/* The report filter bar (inline styles → !important): two columns of full-width fields, big buttons, scrollable data tables. */
+.wr-an-bar { padding: .75rem !important; }
+.wr-an-bar > div:first-child { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .625rem !important; align-items: end; }
+.wr-an-bar label { min-width: 0; }
+.wr-an-bar select, .wr-an-bar input[type='date'], .wr-an-bar input[type='text'] { max-width: none !important; width: 100% !important; min-height: 2.75rem; font-size: 1rem !important; }
+.wr-an-bar > div:first-child > label:has(input[type='checkbox']), .wr-an-bar > div:first-child > button { grid-column: span 1; min-height: 2.75rem; }
+.wr-an-bar button { min-height: 2.75rem; padding-inline: 1rem !important; }
+.wr-an-noprint { width: 100%; }
+.wr-an-noprint input[type='text'] { width: 100% !important; }
+/* Comparison / preview / report tables keep a readable width and scroll inside their own container (never the whole page). */
+.fi-page-content div:has(> table:not(.fi-ta-table)) { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; max-width: 100%; }
+.fi-page-content table:not(.fi-ta-table) { min-width: 32rem; }
+canvas, .fi-wi-chart, .wr-chart, svg.wr-chart { max-width: 100%; }
+.fi-wi-stats-overview-stats-ctn, .fi-wi-stats-overview { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
+.fi-wi-stats-overview-stat { padding: .75rem; }
+
+/* ---------- 10. Motion ---------- */
+@media (prefers-reduced-motion: reduce) {
+    .wam *, .fi-sidebar, .fi-modal-window, .fi-dropdown-panel { transition: none !important; animation: none !important; }
+    .wam-langs-list, .fi-tabs { scroll-behavior: auto; }
+}
