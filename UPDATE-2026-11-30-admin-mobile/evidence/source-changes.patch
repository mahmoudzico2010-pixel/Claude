index 0000000..9ff8996
--- /dev/null
+++ b/app/Http/Controllers/Admin/AdminLanguageController.php
@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use App\Support\Admin\AdminLocales;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+/** Stores the control-panel interface language (cookie only: no database change, no effect on content or the public site). */
+final class AdminLanguageController extends Controller
+{
+    public function __invoke(Request $request): RedirectResponse
+    {
+        $code = (string) $request->input('lang', '');
+        abort_unless(AdminLocales::isAvailable($code), 422);
+
+        // Back to the page the administrator was on, but only inside the panel.
+        $back = (string) $request->input('return', '');
+        $path = parse_url($back, PHP_URL_PATH);
+        $prefix = '/'.trim((string) config('wadi.admin.path', 'admin'), '/');
+        $to = is_string($path) && str_starts_with($path, $prefix)
+            ? $path.(($q = parse_url($back, PHP_URL_QUERY)) ? '?'.$q : '')
+            : $prefix;
+
+        return redirect($to)->withCookie(cookie(AdminLocales::COOKIE, $code, 60 * 24 * 365, '/', null, $request->isSecure(), true, false, 'lax'));
+    }
+}
diff --git a/app/Http/Middleware/SetAdminLocale.php b/app/Http/Middleware/SetAdminLocale.php
new file mode 100644
index 0000000..470c834
--- /dev/null
+++ b/app/Http/Middleware/SetAdminLocale.php
@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use App\Support\Admin\AdminLocales;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\App;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Applies the administrator's chosen interface language to the control panel (and to Livewire updates, which is why it is a
+ * persistent panel middleware). With no valid choice the panel keeps the site's configured language, so nothing changes for
+ * an administrator who never switches.
+ */
+final class SetAdminLocale
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $chosen = $request->cookie(AdminLocales::COOKIE);
+
+        if (AdminLocales::isAvailable(is_string($chosen) ? $chosen : null)) {
+            App::setLocale($chosen);
+        }
+
+        return $next($request);
+    }
+}
