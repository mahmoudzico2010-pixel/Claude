+        var endBox = $('.fi-topbar-end');
+        if (topbar && !$('.wam-title', topbar)) {
+            var link = $('.fi-topbar-start a') || $('.fi-sidebar-header a');
+            var a = document.createElement('a');
+            a.className = 'wam-title';
+            a.href = link ? link.getAttribute('href') : '/';
+            var s = document.createElement('small'); s.textContent = brandName();
+            var st = document.createElement('strong'); st.textContent = pageTitle();
+            a.appendChild(s); a.appendChild(st);
+            topbar.insertBefore(a, endBox && endBox.parentNode === topbar ? endBox : null);
+            injected.push(a);
+        }
+        var end = $('.fi-topbar-end');
+        var field = $('.fi-global-search-ctn');
